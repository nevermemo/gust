struct Frame
{
    uint id;
    uint fill_a[3];
    float4 dir;
    uint tag;
    uint fill_b[3];
    float4x4 basis;
};

struct Slot
{
    uint flag;
    uint fill_a[3];
    Frame frame;
    float weight;
    uint fill_b[3];
};

[[vk::binding(0, 0)]] StructuredBuffer<Slot> slot;
[[vk::binding(1, 0)]] StructuredBuffer<float> k;
[[vk::binding(2, 0)]] RWStructuredBuffer<Slot> __gust_out;

Frame frame_mix(Frame frame, float k)
{
    var mixed = frame;
    mixed.id = (frame.id + uint(1));
    mixed.fill_a = frame.fill_b;
    mixed.dir = __gust_mul(mul(frame.basis, frame.dir), k);
    mixed.tag = (frame.tag + frame.id);
    mixed.fill_b = frame.fill_a;
    mixed.basis = transpose(frame.basis);
    return mixed;
}

Slot slot_step(Slot slot, float k)
{
    var stepped = slot;
    stepped.flag = (slot.flag + uint(1));
    stepped.fill_a = slot.fill_b;
    stepped.frame.id = slot.frame.tag;
    stepped.frame.fill_a = slot.frame.fill_b;
    stepped.frame.dir = (mul(slot.frame.basis, slot.frame.dir) + float4(k));
    stepped.frame.tag = slot.frame.id;
    stepped.frame.fill_b = slot.frame.fill_a;
    stepped.frame.basis = transpose(slot.frame.basis);
    stepped.weight = __gust_mul(slot.weight, k);
    stepped.fill_b = slot.fill_a;
    return stepped;
}

// @rust kernel: wide::slot_step_map_kernel
[shader("compute")]
[numthreads(256, 1, 1)]
void gpu_wide_slot_step_map_kernel(uint3 __gust_gid : SV_DispatchThreadID)
{
    uint __gpu_len_slot;
    uint __gpu_stride_slot;
    slot.GetDimensions(__gpu_len_slot, __gpu_stride_slot);
    uint __gpu_len_k;
    uint __gpu_stride_k;
    k.GetDimensions(__gpu_len_k, __gpu_stride_k);
    uint __gpu_len___gust_out;
    uint __gpu_stride___gust_out;
    __gust_out.GetDimensions(__gpu_len___gust_out, __gpu_stride___gust_out);
    var __gust_n = __gpu_len___gust_out;
    var __gust_rounds = ((__gust_n / uint(16776960)) + uint((((__gust_n % uint(16776960)) != uint(0)))));
    var __gust_end_2 = __gust_rounds;
    for (var __gust_round = uint(0); __gust_round < __gust_end_2; __gust_round++)
    {
        var __gust_j = (__gust_gid.x + __gust_mul(__gust_round, uint(16776960)));
        if ((__gust_j < __gust_n))
        {
            var __gust_i0 = __gust_j;
            if ((__gpu_len_slot == uint(1)))
            {
                __gust_i0 = uint(0);
            }
            var __gust_i1 = __gust_j;
            if ((__gpu_len_k == uint(1)))
            {
                __gust_i1 = uint(0);
            }
            var __gust_v0 = slot[__gust_i0];
            var __gust_v1 = k[__gust_i1];
            var __gust_r = slot_step(__gust_v0, __gust_v1);
            __gust_out[__gust_j] = __gust_r;
        }
    }
}

