float score(float x)
{
    if ((x > float(0.0)))
    {
        return ((x * float(2.5)) + float(1.0));
    }
    else     if ((x < float(0.0)))
    {
        return (-x);
    }
    else
    {
        return float(7.0);
    }
}

uint mask(uint x)
{
    uint divisor = 2;
    uint quotient = __gust_div(x, divisor);
    (quotient += uint(1));
    if (((x & uint(1)) == uint(0)))
    {
        return ((((__gust_not(x) & uint(255))) + uint(2)) + quotient);
    }
    else
    {
        return (x + uint(1024));
    }
}

// @rust kernel: semantics::run
[shader("compute")]
[numthreads(64, 1, 1)]
void gpu_semantics_run(uint3 id : SV_DispatchThreadID)
